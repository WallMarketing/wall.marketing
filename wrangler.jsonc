{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wall-marketing",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bots",
      "database_id": "3736dfa4-cbce-4195-96d2-dc5eb566925b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "wall-images"
    }
  ]
}
